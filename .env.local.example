NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
NEXT_PUBLIC_DEPLOYMENT_URL=
NEXT_PUBLIC_EMAIL_FROM_ADDRESS=

# Set to true when running `firebase emulators:start`.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Server-only Firebase Admin values. Keep these out of NEXT_PUBLIC_*.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
INITIAL_ADMIN_EMAIL=
ALLOW_ADMIN_SELF_SIGNUP=false

# External intake API. Use a comma-separated list for multiple keys.
# Plaintext keys are supported for local development; production should use sha256:<hex-hash>.
INTAKE_API_KEYS=
INTAKE_DUPLICATE_WINDOW_SECONDS=300
INTAKE_ASSESSMENT_OWNER_UID=
VIDEO_SIGNED_URL_TTL_SECONDS=3600
# Candidate assessment links expire this many days after creation.
ASSESSMENT_LINK_EXPIRY_DAYS=7

# Optional demo seeding script values.
DEMO_ADMIN_UID=
DEMO_ADMIN_EMAIL=
