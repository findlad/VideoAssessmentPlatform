rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isServerTimestamp(fieldName) {
      return request.resource.data[fieldName] == request.time;
    }

    function isValidEmail(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 320
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function hasOnlyQuestionRequestFields() {
      return request.resource.data.keys().hasOnly([
        'createdBy',
        'createdByEmail',
        'targetEmail',
        'questions',
        'questionCount',
        'responseCount',
        'status',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidQuestionRequest() {
      return isSignedIn()
        && hasOnlyQuestionRequestFields()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail is string
        && isValidEmail(request.resource.data.targetEmail)
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0
        && request.resource.data.questions.size() <= 5
        && request.resource.data.questionCount == request.resource.data.questions.size()
        && request.resource.data.responseCount == 0
        && request.resource.data.status == 'requested'
        && isServerTimestamp('createdAt')
        && isServerTimestamp('updatedAt');
    }

    function isValidQuestionResponseUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status', 'responseCount', 'updatedAt'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.targetEmail == resource.data.targetEmail
        && request.resource.data.questions == resource.data.questions
        && request.resource.data.questionCount == resource.data.questionCount
        && request.resource.data.status in ['in-progress', 'responded']
        && request.resource.data.responseCount is int
        && request.resource.data.responseCount > 0
        && request.resource.data.responseCount <= resource.data.questionCount
        && isServerTimestamp('updatedAt');
    }

    function isQuestionOwner(questionId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/questions/$(questionId)).data.createdBy == request.auth.uid;
    }

    function isValidAnswerMetadata(questionId, answerId) {
      return request.resource.data.keys().hasOnly([
        'questionIndex',
        'question',
        'storagePath',
        'contentType',
        'updatedAt'
      ])
        && answerId.matches('answer-[1-5]')
        && request.resource.data.questionIndex is int
        && request.resource.data.questionIndex >= 0
        && request.resource.data.questionIndex < 5
        && request.resource.data.question is string
        && request.resource.data.storagePath.matches('^interviewAnswers/' + questionId + '/answer-[1-5]\\.(webm|mp4)$')
        && request.resource.data.contentType.matches('^video/.*')
        && isServerTimestamp('updatedAt');
    }

    function hasOnlyMailFields() {
      return request.resource.data.keys().hasOnly([
        'from',
        'to',
        'metadata',
        'message',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidMailMetadata() {
      return request.resource.data.metadata.keys().hasOnly([
        'type',
        'fileName',
        'questionFileId',
        'targetEmail',
        'questionCount',
        'interviewLink'
      ])
        && request.resource.data.metadata.type == 'interview-request'
        && request.resource.data.metadata.fileName is string
        && request.resource.data.metadata.fileName == request.resource.data.metadata.questionFileId
        && isValidEmail(request.resource.data.metadata.targetEmail)
        && request.resource.data.metadata.questionCount is int
        && request.resource.data.metadata.questionCount > 0
        && request.resource.data.metadata.questionCount <= 5
        && request.resource.data.metadata.interviewLink is string;
    }

    function hasValidMailMessage() {
      return request.resource.data.message.keys().hasOnly([
        'subject',
        'text',
        'html'
      ])
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string
        && request.resource.data.message.html is string;
    }

    function isValidMailRequest() {
      return hasOnlyMailFields()
        && (!request.resource.data.keys().hasAny(['from']) || isValidEmail(request.resource.data.from))
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1
        && isValidEmail(request.resource.data.to[0])
        && request.resource.data.metadata is map
        && request.resource.data.message is map
        && hasValidMailMetadata()
        && hasValidMailMessage()
        && isServerTimestamp('createdAt')
        && isServerTimestamp('updatedAt');
    }

    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    match /assessments/{assessmentId} {
      allow read, write: if isSignedIn();
    }

    match /questions/{questionId} {
      allow create: if isValidQuestionRequest();
      allow get: if true;
      allow list: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if isValidQuestionResponseUpdate();
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /answers/{answerId} {
        allow create, update: if isValidAnswerMetadata(questionId, answerId);
        allow read: if isQuestionOwner(questionId);
        allow delete: if isQuestionOwner(questionId);
      }
    }

    match /mail/{mailId} {
      allow create: if isValidMailRequest();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
